{
  "expo": {
    "name": "Juliana Prado",
    "slug": "julianaprado-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "julianaprado",
    "userInterfaceStyle": "light",
    "runtimeVersion": { "policy": "fingerprint" },
    "ios": {
      "bundleIdentifier": "br.com.julianaprado.app",
      "supportsTablet": false
    },
    "android": {
      "package": "br.com.julianaprado.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#3A3539",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#3A3539",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#B8994A",
          "defaultChannel": "avisos"
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/CormorantGaramond_500Medium.ttf",
            "./assets/fonts/CormorantGaramond_600SemiBold.ttf",
            "./assets/fonts/CormorantGaramond_700Bold.ttf",
            "./assets/fonts/Inter_400Regular.ttf",
            "./assets/fonts/Inter_500Medium.ttf",
            "./assets/fonts/Inter_600SemiBold.ttf",
            "./assets/fonts/Inter_700Bold.ttf"
          ]
        }
      ],
      "expo-updates"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
