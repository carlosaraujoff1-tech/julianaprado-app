{
  "expo": {
    "name": "Juliana Prado",
    "slug": "julianaprado-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "julianaprado",
    "userInterfaceStyle": "light",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "ios": {
      "bundleIdentifier": "br.com.julianaprado.app",
      "supportsTablet": false
    },
    "android": {
      "package": "br.com.julianaprado.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#3A3539",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#3A3539",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#B8994A",
          "defaultChannel": "avisos"
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/CormorantGaramond_500Medium.ttf",
            "./assets/fonts/CormorantGaramond_600SemiBold.ttf",
            "./assets/fonts/CormorantGaramond_700Bold.ttf",
            "./assets/fonts/Inter_400Regular.ttf",
            "./assets/fonts/Inter_500Medium.ttf",
            "./assets/fonts/Inter_600SemiBold.ttf",
            "./assets/fonts/Inter_700Bold.ttf"
          ]
        }
      ],
      "expo-updates",
      [
        "expo-image-picker",
        {
          "photosPermission": "O app usa suas fotos apenas quando você escolhe uma imagem para enviar.",
          "cameraPermission": false,
          "microphonePermission": false,
          "colors": {
            "cropToolbarColor": "#3A3539",
            "cropToolbarIconColor": "#FFFFFF",
            "cropToolbarActionTextColor": "#B8994A",
            "cropBackButtonIconColor": "#FFFFFF",
            "cropBackgroundColor": "#2B272A"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "carlosaraujo1308s-team",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "e2e6ec4d-f4dc-4a97-af48-07e1897452af"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/e2e6ec4d-f4dc-4a97-af48-07e1897452af"
    }
  }
}
